<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>e2e_gc</AssemblyName>
    <DebugType>none</DebugType>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETCore.App.Ref" Version="9.0.6" PrivateAssets="all" />
    <Reference Include="Microsoft.NETCore.App.Ref9">
      <HintPath>$(NuGetPackageRoot)microsoft.netcore.app.ref\9.0.6\ref\net9.0\System.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>e2e_dec</AssemblyName>
    <DebugType>none</DebugType>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <UseAppHost>false</UseAppHost>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Runtime">
      <HintPath>$(NuGetPackageRoot)microsoft.netcore.app.ref\9.0.6\ref\net9.0\System.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Console">
      <HintPath>$(NuGetPackageRoot)microsoft.netcore.app.ref\9.0.6\ref\net9.0\System.Console.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>

using System;
using System.Text;

namespace E2eSbFmtProbe
{
    public static class Program
    {
        static int failures = 0;

        static string Esc(string s)
        {
            if (s == null) return "<null>";
            return s.Replace("\\", "\\\\").Replace("\r", "\\r").Replace("\n", "\\n");
        }

        static void Check(bool ok, string name, string actual)
        {
            if (ok)
                Console.WriteLine("PASS " + name);
            else
            {
                failures++;
                Console.WriteLine("FAIL " + name + " got=" + Esc(actual));
            }
        }

        public static int Main()
        {
            // A. AppendFormat with {0} {1} placeholders, int + string args
            var a = new StringBuilder();
            StringBuilder retA = a.AppendFormat("{0} {1}", 42, "apples");
            Check(a.ToString() == "42 apples", "AppendFormat {0} {1} int+string", a.ToString());
            Check((object)retA == (object)a, "AppendFormat returns same builder", retA == null ? "<null>" : "different");

            // B. AppendLine()
            Check(Environment.NewLine == "\r\n", "Environment.NewLine is CRLF", Environment.NewLine);
            var b = new StringBuilder("line1");
            b.AppendLine();
            Check(b.ToString() == "line1\r\n", "AppendLine()", b.ToString());

            // C. AppendLine(string)
            var c = new StringBuilder();
            c.AppendLine("hello");
            Check(c.ToString() == "hello\r\n", "AppendLine(string)", c.ToString());

            // D. chained Insert/Remove/Replace equals expected final string
            var d = new StringBuilder("Hello World");
            d.Insert(5, ",")             // Hello, World
             .Remove(5, 1)               // Hello World
             .Insert(11, "!")            // Hello World!
             .Replace("World", "il2cpp") // Hello il2cpp!
             .Replace('!', '?');         // Hello il2cpp?
            Check(d.ToString() == "Hello il2cpp?", "chained Insert/Remove/Replace", d.ToString());

            // E. grand finale: one builder through the whole sequence
            var e = new StringBuilder();
            e.AppendFormat("[{0}|{1}]", 7, "kit")
             .AppendLine()
             .Append("alpha-beta-gamma")
             .Remove(0, 9)
             .Replace('-', '_')
             .Insert(16, "!")
             .Remove(16, 1)
             .Replace('_', ' ')
             .AppendLine("end");
            string expE = "alpha beta gamma\r\nend\r\n";
            Check(e.ToString() == expE, "grand finale sequence", e.ToString());

            if (failures == 0)
                Console.WriteLine("ALL-PASS");
            else
                Console.WriteLine("ALL-FAIL failures=" + failures);
            return 0;
        }
    }
}

# build outputs
bin/
obj/
build/
builds/
*.user

# generated code output
gen/
gen_test/
# explicit gen-prefixed output dirs (NOT gen*/: that glob matches e2e case dirs
# tests/cases/generics/ and tests/cases/genlist/ and would ignore their sources)
gen_array/
gen_array_core/
gen-check/
gen-dbg/
/gen_sbchain

# test fixture build output (build via scripts/build-fixtures.ps1)
tests/fixtures/out/

# e2e test case build outputs (regenerated by scripts/run-tests.ps1)
tests/cases/*/out/
tests/cases/*/build_*/
# e2e test case transpiler-generated output (regenerated by scripts/run-tests.ps1;
# matrixcase uses gen_link/ instead of gen/)
tests/cases/*/gen_link/
tests/cases/*/gen-link/
tests/cases/*/gen_probe/

# runtime test build output (cmake -G "MinGW Makefiles" from tests/runtime)
tests/runtime/build_mingw/

# bench/research build outputs + results
results/
tests/*/out/
tests/*/obj/

# superpowers sdd workspace
.superpowers/

# opencode local state
.opencode/

# .NET Core reference source copy (fetched, never committed)
reference/

# stray compiler/e2e artifacts (regenerated on demand, never committed)
*.o
*.obj
*.trx
# root-level test run captures (test_*.out.txt / test_*.err.txt; general form,
# no tracked file matches *.out.txt/*.err.txt anywhere in the repo)
*.out.txt
*.err.txt
console_capture.txt
console_input.txt
debugext_capture.txt
debugext_stderr.txt
tests/cases/mathextra/actual.txt

# root-level probe/debug output (batch 15 leftovers)
build_tailprobe/
/gen_*/
/out/
/tmp_*.res
# runtime test build dirs
tests/runtime/build_*/
# in-flight markers
*.inflight

tests/cases/*/gen_fmt2*/
tests/cases/*/gen_fmt2fix/
tests/cases/*/gen_fmt2fix2/

# agent run outputs
/test_*.out
/*.out
/build_runtime_*_log*
/debuggerext_stderr.txt
/*.txt.tmp

tests/cases/*/gen2/
tests/cases/*/gen3/
tests/cases/*/gen4/
tests/cases/*/gen5/

# agent/backup snapshots (never committed; *_backup_<timestamp>/ dirs)
*_backup_*/
.opencode-backup-cons/
cmpgrid.txt

# scratch probes (tmp/ is throwaway analysis scratch, not source)
/tmp/

# historical shard/probe/dump outputs (never committed)
/r*shard/
/dump_*/
*.bak*

# e2e diff-run generated output dirs observed untracked at freeze (c093c6d9);
# per-family patterns (NOT tests/cases/*/gen*/: gen_v*/gen_stab/... snapshots
# are intentionally tracked in several cases and must stay addable)
tests/cases/*/gen_diff*/
tests/cases/*/gen_a3verify/
tests/cases/*/gen_d2/
tests/cases/*/gen_mingw/
tests/cases/*/gen_msvc/
tests/cases/*/gen_new/
tests/cases/*/gen_p1/
tests/cases/*/gen_p2/
tests/cases/*/gen_pre/
tests/cases/*/gen-bin-r3/
tests/cases/*/gen-prew2/
tests/cases/*/gen-scan/
# e2e staging dirs (out_stage, out_stage_mingw/msvc/clang/diff)
tests/cases/*/out_stage*/
# bench/tool output dirs (tests/bench/out8/...)
tests/*/out*/
# probe scratch (repo root + nested in e2e cases)
w2probe_tmp/
# per-case run captures (sweep_run.out/.err, transpile.log)
tests/cases/*/*.log
tests/cases/*/*.out
tests/cases/*/*.err

# root report output (scripts/gen-diffprobes.ps1 default output dir)
/final-report/
# other AI tool memory dir
/.workbuddy-ai/

# git worktree isolation dirs (P-DX parallel execution)
/.worktrees/

# e2e net48 oracle staging (regenerated on demand, never committed)
tests/cases/*/out_oracle/
.work/

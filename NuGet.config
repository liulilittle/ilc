<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-level source pin (2026-09-11): network restored; keep <clear/> so the
     machine's stale local-offline user source does not shadow nuget.org. -->
<!-- OFF-C-DRIVE (2026-11-01, user directive): every artifact of this project must
     live under F:\il2cpp\.opencode. The default global-packages folder is
     C:\Users\<user>\.nuget\packages (measured: 487 MB / 3580 files of OUR restore
     output on the system drive), so pin it to the repo scratch area instead. The
     path is absolute because worktrees share one cache; scripts in this repo
     already hardcode F:\il2cpp\.opencode paths (e.g. sweep-cases.ps1 ccache). -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="F:\il2cpp\.opencode\nuget\packages" />
  </config>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
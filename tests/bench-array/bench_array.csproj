<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>bench_array</AssemblyName>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile only this file: bench_array_core.cs lives next to it and has
         its own Main (the two programs must stay separate assemblies). -->
    <Compile Include="bench_array.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48"
                      Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>

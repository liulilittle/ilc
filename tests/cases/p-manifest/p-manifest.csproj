<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AssemblyName>p-manifest</AssemblyName>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48"
                      Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <!-- nb10: the SIDECAR application manifest. Windows honors the
       "app.exe.manifest" file next to the executable, and il2cppc picks the
       same file up automatically (no explicit flag needed) to embed it as
       RT_MANIFEST id 1. asInvoker keeps the process non-elevated so the
       differential harness can run it. -->
  <ItemGroup>
    <None Update="p-manifest.exe.manifest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

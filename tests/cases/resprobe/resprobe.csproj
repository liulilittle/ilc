<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <AssemblyName>resprobe</AssemblyName>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48"
                      Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- R2/R3: the .resources blob is PRE-GENERATED with the NETFX 4.8
         resgen.exe from Strings.resx (the ResXFileRef byte[]/stream entries
         need the real ResourceWriter) and embedded as-is; the R1 string-only
         resx path is the drawable source kept under the same name. -->
    <EmbeddedResource Include="Strings.resources" />
    <EmbeddedResource Include="img.png" LogicalName="resprobe.img.png" />
    <EmbeddedResource Include="blob.bin" LogicalName="resprobe.blob.bin" />
  </ItemGroup>
</Project>
        Console.WriteLine("wm_command_count_after=" + wmCommandCount);
        Console.WriteLine("click_count=" + clickCount);
        Console.WriteLine("wm_paint_count=" + wmPaintCount);
        Console.WriteLine("begin_paint_ok=" + beginPaintOk);

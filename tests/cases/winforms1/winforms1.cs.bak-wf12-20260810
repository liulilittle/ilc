        Console.WriteLine("wm_create_count=" + wmCreateCount);
        Console.WriteLine("wm_command_count=" + wmCommandCount);

        // Inject a click: WM_COMMAND to the Form with the button's id + hwnd.
        IntPtr zero = IntPtr.Zero;

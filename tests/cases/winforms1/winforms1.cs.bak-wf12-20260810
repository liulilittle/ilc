        // activation ORDER and activates each child (SetActiveWindow).
        MdiActSeq = "";
        int postActA = PostMessageW(hMdiClient, WM_MDIACTIVATE, hMdiA, IntPtr.Zero);
        int postActB = PostMessageW(hMdiClient, WM_MDIACTIVATE, hMdiB, IntPtr.Zero);

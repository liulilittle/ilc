        IntPtr oldProc = SetWindowLongPtrW(hPanel, GWLP_WNDPROC, panelFn);
        P15SubclassOk = oldProc != IntPtr.Zero;
        Console.WriteLine("p15_subclass_ok=" + P15SubclassOk);

